{{ 'custom.css' | asset_url | stylesheet_tag }}

<section class="hero-section">
  {% if section.settings.media_type == 'video' %}
    <video
      id="heroVideo"
      class="hero-media hero-video"
      {% if section.settings.autoplay %}autoplay{% endif %}
      {% if section.settings.loop %}loop{% endif %}
      muted
      playsinline
      preload="auto"
      x-webkit-airplay="allow"
    >
      <source src="{{ section.settings.desktop_video }}" type="video/mp4" media="(min-width: 768px)">
      <source src="{{ section.settings.mobile_video }}" type="video/mp4" media="(max-width: 767px)">
    </video>
  {% else %}
    <div class="hero-media hero-image-container">
      {% if section.settings.desktop_image != blank %}
        {{ section.settings.desktop_image | image_url: width: 2000 | image_tag:
           class: 'hero-image desktop-hero-image',
           loading: 'eager',
           sizes: '100vw',
           widths: '375, 550, 750, 1100, 1500, 2000'
        }}
      {% endif %}
      {% if section.settings.mobile_image != blank %}
        {{ section.settings.mobile_image | image_url: width: 1000 | image_tag:
           class: 'hero-image mobile-hero-image',
           loading: 'eager',
           sizes: '100vw',
           widths: '375, 550, 750, 1000'
        }}
      {% endif %}
    </div>
  {% endif %}

  <div class="hero-content">
    <div class="hero-header-text">
      <h1>{{ section.settings.header_text }}</h1>
      {% if section.settings.header_subtext != blank %}
        <div class="hero-header-subtext">{{ section.settings.header_subtext }}</div>
      {% endif %}
    </div>

    <div class="hero-subcontent">
      <p>{{ section.settings.subheader_text }}</p>
      <a href="{{ section.settings.button_link }}" class="standard-button hero-button">{{ section.settings.button_text }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Media Section",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "header",
      "content": "Video Settings",
      "info": "These settings only apply when Media Type is set to Video"
    },
    {
      "type": "url",
      "id": "desktop_video",
      "label": "Desktop Video URL",
      "info": "Upload video for desktop devices"
    },
    {
      "type": "url",
      "id": "mobile_video",
      "label": "Mobile Video URL",
      "info": "Upload video for mobile devices"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop Video",
      "default": true
    },
    {
      "type": "header",
      "content": "Image Settings",
      "info": "These settings only apply when Media Type is set to Image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image",
      "info": "Recommended size: 2000px × 800px"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "info": "Recommended size: 750px × 1000px"
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Header Text",
      "default": "Welcome to Our Store"
    },
    {
      "type": "text",
      "id": "header_subtext",
      "label": "Header Subtext",
      "default": "The best products around",
      "info": "Appears below the main heading"
    },
    {
      "type": "text",
      "id": "subheader_text",
      "label": "Subheader Text",
      "default": "Discover our latest products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    }
  ],
  "presets": [
    {
      "name": "Hero Media Section",
      "category": "Media",
      "settings": {
        "media_type": "image",
        "header_text": "Welcome to Our Store",
        "header_subtext": "Premium quality products made just for you",
        "subheader_text": "Discover our latest products",
        "button_link": "/collections/all",
        "button_text": "Shop Now"
      }
    }
  ]
}
{% endschema %}

{% stylesheet %}
.hero-section {
  position: relative;
  width: 100%;
  height: 100vh;
  max-height: 800px;
  overflow: hidden;
  background-color: #000000;
}

.hero-media {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.hero-video {
  object-fit: cover;
}

.hero-image-container {
  height: 100%;
}

.hero-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.desktop-hero-image {
  display: block;
}

.mobile-hero-image {
  display: none;
}

.hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 20px;
  height: 100%;
  color: white;
}

.hero-header-text {
  position: absolute;
  bottom: 40px;
  left: 40px;
  max-width: 300px;
}

.hero-header-text h1 {
  color: white;

  font-size: 50px;
  line-height: 1.15em;
  margin: 0;
  margin-bottom: 10px;
}

.hero-subcontent {
  position: absolute;
  bottom: 40px;
  right: 40px;
  text-align: left;
  max-width: 300px;
  font-weight: 100;
}

.hero-button {
  display: inline-block;
  padding: 1rem 2rem;
  background-color: #ffffff;
  color: #000000;
  text-decoration: none;
  border-radius: 4px;
  transition: background-color 0.3s ease;
  margin-top: 10px;
}

.hero-button:hover {
  background-color: #f0f0f0;
}

@media (max-width: 767px) {
  .desktop-hero-image {
    display: none;
  }

  .mobile-hero-image {
    display: block;
  }

  .hero-content {
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding-left: 20px;
  }

  .hero-header-text {
    position: static;
    text-align: left;
    margin-bottom: auto;
    padding-left: 0;
  }

  .hero-header-text h1 {
    font-weight: 700;
    font-size: 34px;
    line-height: 1.15em;
    margin: 0;
    margin-bottom: 8px;
    max-width: 204px;
    padding-top: 48px;
  }

  .hero-subcontent {
    position: static;
    text-align: left;
    margin-top: auto;
    padding-left: 0;
    width: 100%;
    max-width: 100%;
    padding-bottom: 10px;
  }
}
{% endstylesheet %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  const video = document.getElementById('heroVideo');

  if (video) {
    // Force play on iOS
    video.load();

    // Play video after a small delay to ensure loading
    setTimeout(() => {
      const playPromise = video.play();

      if (playPromise !== undefined) {
        playPromise.catch(error => {
          console.log('Video play error:', error);
          // Try to play again on user interaction
          document.addEventListener('touchstart', () => {
            video.play().catch(e => console.log('Play on touch failed:', e));
          }, { once: true });
        });
      }
    }, 100);

    // Monitor video state
    video.addEventListener('playing', () => {
      console.log('Video is playing');
    });

    video.addEventListener('waiting', () => {
      console.log('Video is waiting/buffering');
    });

    video.addEventListener('error', (e) => {
      console.log('Video error:', video.error);
    });
  }
});
{% endjavascript %}