<section class="home-social-carousel color-{{ section.settings.color_scheme }}">
  <div class="main-contain">
    <div class="socials-container">
      <div class="social-header">
        <h2 class="mob-lrg">{{ section.settings.heading }}</h2>
        <div class="social-icons">
          <!-- Instagram -->
          {% if section.settings.instagram_icon %}
            <a href="{% if section.settings.instagram_link != blank %}{{ section.settings.instagram_link }}{% else %}#{% endif %}"
               target="_blank"
               class="social-icon">
              <img src="{{ section.settings.instagram_icon | image_url: width: 48 }}"
                   alt="Instagram"
                   width="24"
                   height="24"
                   loading="lazy">
            </a>
          {% endif %}

          <!-- TikTok -->
          {% if section.settings.tiktok_icon %}
            <a href="{% if section.settings.tiktok_link != blank %}{{ section.settings.tiktok_link }}{% else %}#{% endif %}"
               target="_blank"
               class="social-icon">
              <img src="{{ section.settings.tiktok_icon | image_url: width: 48 }}"
                   alt="TikTok"
                   width="24"
                   height="24"
                   loading="lazy">
            </a>
          {% endif %}

          <!-- X (Twitter) -->
          {% if section.settings.x_icon %}
            <a href="{% if section.settings.x_link != blank %}{{ section.settings.x_link }}{% else %}#{% endif %}"
               target="_blank"
               class="social-icon">
              <img src="{{ section.settings.x_icon | image_url: width: 48 }}"
                   alt="X (Twitter)"
                   width="24"
                   height="24"
                   loading="lazy">
            </a>
          {% endif %}

          <!-- LinkedIn -->
          {% if section.settings.linkedin_icon %}
            <a href="{% if section.settings.linkedin_link != blank %}{{ section.settings.linkedin_link }}{% else %}#{% endif %}"
               target="_blank"
               class="social-icon">
              <img src="{{ section.settings.linkedin_icon | image_url: width: 48 }}"
                   alt="LinkedIn"
                   width="24"
                   height="24"
                   loading="lazy">
            </a>
          {% endif %}

          <!-- Facebook -->
          {% if section.settings.facebook_icon %}
            <a href="{% if section.settings.facebook_link != blank %}{{ section.settings.facebook_link }}{% else %}#{% endif %}"
               target="_blank"
               class="social-icon">
              <img src="{{ section.settings.facebook_icon | image_url: width: 48 }}"
                   alt="Facebook"
                   width="24"
                   height="24"
                   loading="lazy">
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Updated Carousel Grid with Navigation -->
      <div class="instagram-carousel-wrapper">
        <button class="carousel-nav carousel-nav-prev" aria-label="Previous">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="instagram-carousel" id="instagram-carousel-{{ section.id }}">
          {% for block in section.blocks %}
            <div class="instagram-item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | img_url: '600x' }}"
                     alt="{{ block.settings.instagram_handle }}"
                     loading="lazy"
                     width="100%"
                     height="auto">
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <button class="carousel-nav carousel-nav-next" aria-label="Next">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    const carousel = document.getElementById('instagram-carousel-{{ section.id }}');
    const prevBtn = carousel.parentElement.querySelector('.carousel-nav-prev');
    const nextBtn = carousel.parentElement.querySelector('.carousel-nav-next');

    const originalItems = Array.from(carousel.querySelectorAll('.instagram-item'));
    const itemCount = originalItems.length;

    // Clone all items for infinite loop
    originalItems.forEach(item => {
      const clone = item.cloneNode(true);
      carousel.appendChild(clone);
    });

    originalItems.forEach(item => {
      const clone = item.cloneNode(true);
      carousel.insertBefore(clone, carousel.firstChild);
    });

    let currentIndex = itemCount; // Start at first real item
    let isAnimating = false;

    function getItemWidth() {
      const item = carousel.querySelector('.instagram-item');
      return item ? item.offsetWidth : 0;
    }

    function updateCarousel(animate = true) {
      const itemWidth = getItemWidth();
      const gap = 20;
      const scrollPosition = currentIndex * (itemWidth + gap);

      if (animate) {
        carousel.style.scrollBehavior = 'smooth';
      } else {
        carousel.style.scrollBehavior = 'auto';
      }

      carousel.scrollLeft = scrollPosition;
    }

    function handleInfiniteLoop() {
      // If we're at or past the last cloned set
      if (currentIndex >= itemCount * 2) {
        currentIndex = itemCount;
        setTimeout(() => {
          updateCarousel(false);
        }, 50);
      }
      // If we're at or before the first cloned set
      else if (currentIndex < itemCount) {
        currentIndex = itemCount * 2 - 1;
        setTimeout(() => {
          updateCarousel(false);
        }, 50);
      }
    }

    function scrollNext() {
      if (isAnimating) return;
      isAnimating = true;

      currentIndex++;
      updateCarousel(true);

      setTimeout(() => {
        handleInfiniteLoop();
        isAnimating = false;
      }, 400);
    }

    function scrollPrev() {
      if (isAnimating) return;
      isAnimating = true;

      currentIndex--;
      updateCarousel(true);

      setTimeout(() => {
        handleInfiniteLoop();
        isAnimating = false;
      }, 400);
    }

    prevBtn.addEventListener('click', scrollPrev);
    nextBtn.addEventListener('click', scrollNext);

    // Initialize position after images load
    function initialize() {
      // Wait for images to load to get correct width
      const images = carousel.querySelectorAll('img');
      let loadedCount = 0;

      function onImageLoad() {
        loadedCount++;
        if (loadedCount === images.length) {
          updateCarousel(false);
        }
      }

      images.forEach(img => {
        if (img.complete) {
          onImageLoad();
        } else {
          img.addEventListener('load', onImageLoad);
        }
      });

      // Fallback if images are cached or fail to load
      setTimeout(() => {
        updateCarousel(false);
      }, 100);
    }

    initialize();

    // Handle window resize
    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        updateCarousel(false);
      }, 100);
    });
  })();
</script>

