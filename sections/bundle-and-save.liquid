<section class="bundle-and-save-section color-{{ section.settings.color_scheme }}">
  <div class="main-contain">
  <div class="bundle-content">
    <!-- Left Side: Title, Description, Button, Prices -->
    <div class="left-content">
      <h2 class="mob-lrg">{{ section.settings.title }}</h2>
      <p>{{ section.settings.description }}</p>
      <p>{{ section.settings.second_description }}</p>

      <!-- Add to Cart Button and Prices -->
      {% assign product = all_products[section.settings.bundle_product] %}
      {% if product %}
        {% comment %} Use the specific variant ID provided {% endcomment %}
        {% assign specific_variant_id = 42385271619719 %}
        {% assign specific_variant = nil %}

        {% comment %} Find the variant with the specific ID {% endcomment %}
        {% for variant in product.variants %}
          {% if variant.id == specific_variant_id %}
            {% assign specific_variant = variant %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% comment %} Fallback to first variant if the ID isn't found {% endcomment %}
        {% unless specific_variant %}
          {% assign specific_variant = product.variants.first %}
        {% endunless %}

        <form method="post" action="/cart/add" class="bundle-form">
          <input type="hidden" name="id" value="{{ specific_variant_id }}">

          <!-- Add to Cart Button -->
          <button type="submit" class="standard-button">{{ section.settings.button_text }}</button>

          <!-- Prices next to button -->
          <div class="price-wrapper">
            {% if specific_variant %}
              <span class="sale-price text-highlight">{{ specific_variant.price | money }}</span>
              {% if specific_variant.compare_at_price > specific_variant.price %}
                <span class="original-price"><s>{{ specific_variant.compare_at_price | money }}</s></span>
              {% endif %}
            {% else %}
              <span class="sale-price text-highlight">{{ product.price | money }}</span>
            {% endif %}
          </div>
        </form>
      {% else %}
        <p>Product not found. Please select a valid product.</p>
      {% endif %}
    </div>

    <!-- Right Side: Image -->
    <div class="right-content">
      <img src="{{ section.settings.bundle_image | image_url }}" alt="Bundle Image" class="home-bundle-image" width="" height="">
    </div>

  </div>
  </div>
</section>




{% schema %}
{
  "name": "Bundle and Save",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Bundle and Save"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Get the best value by bundling three of our top products!"
    },
    {
      "type": "textarea",
      "id": "second_description",
      "label": "Second Description",
      "default": "Limited time offer, don't miss out!"
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Select Bundle Product"
    },
    {
      "type": "image_picker",
      "id": "bundle_image",
      "label": "Bundle Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add to Cart"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "Bundle and Save",
      "category": "Product"
    }
  ]
}
{% endschema %}