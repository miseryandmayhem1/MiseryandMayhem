<section class="home-featured-products">
  <div class="main-contain">
    <div class="header-area">
      <h2>{{ section.settings.header_title }}</h2>
      <a href="{{ section.settings.collection.url }}" class="standard-button">Shop All</a>
    </div>

    <!-- Product Columns -->
<div class="product-columns">
  {% for block in section.blocks %}
    {% if block.settings.product %}
      <div class="product-column">
        <a class="home-product-link" href="/products/{{ block.settings.product.handle }}">
          <img src="{{ block.settings.product.featured_image | img_url: '600x' }}" alt="{{ block.settings.product.title }}" width="" height="">
          <h3 class="home-featured-product-title">{{ block.settings.product.title }}</h3>
          <p>{{ block.settings.custom_text_1 }}</p>
          <p>{{ block.settings.custom_text_2 }}</p>
          {% comment %} <span class="feat-price text-highlight">{{ block.settings.product.price | money }}</span> {% endcomment %}
        </a>
      </div>
    {% else %}
      <div class="product-column">
        <p>No product selected</p>
      </div>
    {% endif %}
  {% endfor %}
</div>

  </div>
</section>



{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "header_title",
      "label": "Header Title",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shop All Collection"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-6"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "custom_text_1",
          "label": "Custom Text Line 1"
        },
        {
          "type": "text",
          "id": "custom_text_2",
          "label": "Custom Text Line 2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Products Section",
      "category": "Home Page"
    }
  ]
}

{% endschema %}
