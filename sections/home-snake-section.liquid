{{ 'custom.css' | asset_url | stylesheet_tag }}

<section class="home-snake-section snake-text-section color-{{ section.settings.color_scheme }}">
  <img src="{{ section.settings.snake_image | image_url }}" class="home-snake" width="" height="" alt="Snake">
  <div class="container main-contain">
    <!-- Snake Image (Left on Desktop, Top on Mobile) -->
    <div class="snake-image">
    </div>

    <!-- Text Section (Right on Desktop, Below on Mobile) -->
    <div class="text-content">
      <h2 class="mob-lrg">{{ section.settings.header_title }}</h2>
      <div class="snake-text-blocks">
      {% for block in section.blocks %}
        {% if block.settings.block_title != blank %}
          <h3 class="snake-block-title">{{ block.settings.block_title }}</h3>
        {% endif %}
        <p>{{ block.settings.normal_text }}</p>
      {% endfor %}
      </div>
      <div class="home-snake-button-container">
        {% if section.settings.button_text != blank and section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="standard-button">{{ section.settings.button_text }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Snake and Text Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "snake_image",
      "label": "Snake Image"
    },
    {
      "type": "text",
      "id": "header_title",
      "label": "Header Title",
      "default": "Header Title Here"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-6"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "text_line",
      "name": "Text Line",
      "settings": [
        {
          "type": "text",
          "id": "block_title",
          "label": "Block Title",
          "default": "Block Title"
        },
        {
          "type": "text",
          "id": "normal_text",
          "label": "Text",
          "default": "Your text content here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Snake and Text Section",
      "category": "Custom",
      "blocks": [
        {
          "type": "text_line",
          "settings": {
            "block_title": "Discover",
            "normal_text": "Explore the amazing world of snakes and their natural habitats."
          }
        },
        {
          "type": "text_line",
          "settings": {
            "block_title": "Education",
            "normal_text": "Learn about different species and their unique characteristics."
          }
        },
        {
          "type": "text_line",
          "settings": {
            "block_title": "Conservation",
            "normal_text": "Protect these creatures and support conservation efforts."
          }
        }
      ]
    }
  ]
}
{% endschema %}