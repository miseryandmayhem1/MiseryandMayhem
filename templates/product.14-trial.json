=\"db-flavor-card\" id=\"dbt-card-ac\" style=\"background:#e8f5ec!important;border-color:#4caf7d!important\">\n        <div class=\"db-flavor-card-info\">\n          <div class=\"db-fname\">Apple Cinnamon</div>\n          <div class=\"db-fdesc\">Sweet apple chunks with warm cinnamon spice</div>\n          <div class=\"db-fbadges\">\n            <span class=\"db-fbadge\" style=\"background:#1a9e96\">16g Protein</span>\n            <span class=\"db-fbadge\" style=\"background:#f5b800;color:#1a1a1a\">6g Fiber</span>\n            <span class=\"db-fbadge\" style=\"background:#4caf7d\">6g Sugar</span>\n          </div>\n        </div>\n        <div class=\"db-qty\">\n          <button class=\"db-qty-btn\" onclick=\"dbtUpdateQty('ac',-2)\">−</button>\n          <span class=\"db-qty-num\" id=\"dbt-qty-ac\">0</span>\n          <button class=\"db-qty-btn\" onclick=\"dbtUpdateQty('ac',2)\">+</button>\n        </div>\n      </div>\n      <div class=\"db-flavor-card\" id=\"dbt-card-classic\" style=\"background:#fdf6e3!important;border-color:#f5b800!important\">\n        <div class=\"db-flavor-card-info\">\n          <div class=\"db-fname\">Classic</div>\n          <div class=\"db-fdesc\">Pure oat goodness — customize with your own toppings</div>\n          <div class=\"db-fbadges\">\n            <span class=\"db-fbadge\" style=\"background:#1a9e96\">16g Protein</span>\n            <span class=\"db-fbadge\" style=\"background:#f5b800;color:#1a1a1a\">6g Fiber</span>\n            <span class=\"db-fbadge\" style=\"background:#f5b800;color:#1a1a1a\">1g Sugar</span>\n          </div>\n        </div>\n        <div class=\"db-qty\">\n          <button class=\"db-qty-btn\" onclick=\"dbtUpdateQty('classic',-2)\">−</button>\n          <span class=\"db-qty-num\" id=\"dbt-qty-classic\">0</span>\n          <button class=\"db-qty-btn\" onclick=\"dbtUpdateQty('classic',2)\">+</button>\n        </div>\n      </div>\n      <div class=\"db-flavor-card\" id=\"dbt-card-maple\" style=\"background:#fff0e8!important;border-color:#e85d1a!important\">\n        <div class=\"db-flavor-card-info\">\n          <div class=\"db-fname\">Maple</div>\n          <div class=\"db-fdesc\">Rich maple sweetness with hearty oats</div>\n          <div class=\"db-fbadges\">\n            <span class=\"db-fbadge\" style=\"background:#1a9e96\">16g Protein</span>\n            <span class=\"db-fbadge\" style=\"background:#f5b800;color:#1a1a1a\">6g Fiber</span>\n            <span class=\"db-fbadge\" style=\"background:#e85d1a\">4g Sugar</span>\n          </div>\n        </div>\n        <div class=\"db-qty\">\n          <button class=\"db-qty-btn\" onclick=\"dbtUpdateQty('maple',-2)\">−</button>\n          <span class=\"db-qty-num\" id=\"dbt-qty-maple\">0</span>\n          <button class=\"db-qty-btn\" onclick=\"dbtUpdateQty('maple',2)\">+</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"db-tally\" id=\"dbt-tally\">0 of 4 selected</div>\n    <div class=\"db-urgency\">⚡ Ships within 2 business days — $14 including shipping</div>\n    <div class=\"db-cta-wrap\">\n      <button class=\"db-cta-btn\" id=\"dbt-main-btn\" onclick=\"dbtAddToCart()\" disabled>Select your 4 pouches to continue →</button>\n      <div class=\"db-cta-note\">🔒 Secure checkout · No subscription required · Shipping included</div>\n    </div>\n  </div>\n</div>\n\n<div style=\"background:#fdf6ec!important;padding:0 16px 40px!important;margin:0!important\">\n  <div style=\"max-width:900px!important;margin:0 auto!important;background:#1a9e96!important;border-radius:16px!important;padding:28px 36px!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:24px!important;flex-wrap:wrap!important\">\n    <div style=\"margin:0!important;padding:0!important\">\n      <div style=\"font-family:'Nunito',sans-serif!important;font-size:11px!important;font-weight:900!important;color:#f5b800!important;letter-spacing:2px!important;text-transform:uppercase!important;margin:0 0 6px 0!important;padding:0!important\">Want to try all 3?</div>\n      <div style=\"font-family:'Bebas Neue',sans-serif!important;font-size:32px!important;color:#fff!important;line-height:1!important;margin:0!important;padding:0!important\">Mix &amp; Match All 3 Flavors.</div>\n    </div>\n    <a href=\"https://dawnbreakeroats.com/pages/6-pack-bundle\"\n      style=\"background:#e85d1a!important;color:#fff!important;font-family:'Nunito',sans-serif!important;font-size:14px!important;font-weight:900!important;padding:14px 28px!important;border-radius:60px!important;text-decoration:none!important;white-space:nowrap!important;box-shadow:0 4px 20px rgba(232,93,26,0.4)!important;flex-shrink:0!important;display:inline-block!important\">\n      Build Your 6-Pack →\n    </a>\n  </div>\n</div>\n\n<div class=\"db-nutrition\">\n  <div class=\"db-nutrition-inner\">\n    <div class=\"db-h2\" style=\"margin-bottom:8px!important\">What's Inside</div>\n    <div class=\"db-h2-sub\">Clean ingredients. Nothing to hide.</div>\n    <img src=\"https://cdn.shopify.com/s/files/1/0598/7201/8567/files/bundle-nutrition.png?v=1763065469\" class=\"db-nutrition-img\" alt=\"Dawnbreaker Nutrition Facts\">\n  </div>\n</div>\n\n<div class=\"db-video-section\">\n  <div class=\"db-video-inner\">\n    <div class=\"db-video-h2\">See It In Action</div>\n    <div class=\"db-video-sub\">Ready in 3 minutes. No excuses.</div>\n    <div class=\"db-video-wrap\">\n      <video controls playsinline preload=\"metadata\">\n        <source src=\"https://cdn.shopify.com/videos/c/o/v/16bd06ce90db4a09a44b70eb01e8a002.mov\" type=\"video/mp4\">\n      </video>\n    </div>\n  </div>\n</div>\n\n<div class=\"db-why\">\n  <div class=\"db-inner\">\n    <div class=\"db-h2\">Why Dawnbreaker?</div>\n    <div class=\"db-h2-sub\">Built for every morning</div>\n    <div class=\"db-why-grid\">\n      <div class=\"db-why-card\"><div class=\"db-why-icon\" style=\"background:#1a9e96\">💪</div><div class=\"db-why-title\">Fuel Your Workout</div><div class=\"db-why-text\">16g of protein to power your morning and keep you locked in all day</div></div>\n      <div class=\"db-why-card\"><div class=\"db-why-icon\" style=\"background:#f5b800\">⚡</div><div class=\"db-why-title\">Ready in 3 Minutes</div><div class=\"db-why-text\">Just add water, stir, and go. Built for mornings with zero margin for error</div></div>\n      <div class=\"db-why-card\"><div class=\"db-why-icon\" style=\"background:#e85d1a\">🎒</div><div class=\"db-why-title\">Breakfast That Travels</div><div class=\"db-why-text\">Portable packets — gym bag, office, trail, plane. Your breakfast goes where you go</div></div>\n    </div>\n  </div>\n</div>\n\n<div class=\"db-faq\">\n  <div class=\"db-faq-inner\">\n    <div class=\"db-h2\" style=\"text-align:center;margin-bottom:36px!important\">FAQ</div>\n    <div class=\"db-faq-item\">\n      <button class=\"db-faq-q\" onclick=\"dbtToggleFaq(this)\"><span class=\"db-faq-q-text\">What exactly do I get for $14?</span><span class=\"db-faq-icon\">+</span></button>\n      <div class=\"db-faq-a\">4 individual packets — 2 of each flavor you choose. Shipping is included in the $14 price. No subscription, no hidden fees, no gotchas.</div>\n    </div>\n    <div class=\"db-faq-item\">\n      <button class=\"db-faq-q\" onclick=\"dbtToggleFaq(this)\"><span class=\"db-faq-q-text\">Can I pick all 3 flavors?</span><span class=\"db-faq-icon\">+</span></button>\n      <div class=\"db-faq-a\">This trial is built for 2 flavors — you'll get 2 packets of each. If you want to try all three, our $19.99 6-pack lets you build a mix of all three flavors.</div>\n    </div>\n    <div class=\"db-faq-item\">\n      <button class=\"db-faq-q\" onclick=\"dbtToggleFaq(this)\"><span class=\"db-faq-q-text\">What makes Dawnbreaker different from regular instant oatmeal?</span><span class=\"db-faq-icon\">+</span></button>\n      <div class=\"db-faq-a\">Dawnbreaker is built to fuel your morning, not just fill it. Most instant oatmeal is high in sugar and low in protein and fiber. We flipped that. 16g of protein, high fiber, gluten free, and made with organic oats.</div>\n    </div>\n    <div class=\"db-faq-item\">\n      <button class=\"db-faq-q\" onclick=\"dbtToggleFaq(this)\"><span class=\"db-faq-q-text\">What flavors are available?</span><span class=\"db-faq-icon\">+</span></button>\n      <div class=\"db-faq-a\">Maple, Apple Cinnamon, and Classic. All three have the same 16g protein and clean ingredient profile. It just comes down to what you're in the mood for.</div>\n    </div>\n    <div class=\"db-faq-item\">\n      <button class=\"db-faq-q\" onclick=\"dbtToggleFaq(this)\"><span class=\"db-faq-q-text\">How do I make it?</span><span class=\"db-faq-icon\">+</span></button>\n      <div class=\"db-faq-a\">Add 1/2 cup of water or milk of your choice and microwave for 60 seconds. Stir and you are done.</div>\n    </div>\n    <div class=\"db-faq-item\">\n      <button class=\"db-faq-q\" onclick=\"dbtToggleFaq(this)\"><span class=\"db-faq-q-text\">Do you ship nationwide?</span><span class=\"db-faq-icon\">+</span></button>\n      <div class=\"db-faq-a\">Yes, everywhere in the US. Shipping is included in your $14 trial price.</div>\n    </div>\n    <div id=\"db-yotpo-widget\" style=\"margin-top:40px\"></div>\n  </div>\n</div>\n\n<div class=\"db-sticky\" id=\"dbt-sticky\">\n  <div class=\"db-sticky-left\">Try 4 Packets &nbsp;|&nbsp; <span>$14 Shipped</span></div>\n  <button class=\"db-sticky-btn\" id=\"dbt-sticky-btn\" onclick=\"dbtAddToCart()\" disabled>Select Flavors First</button>\n</div>\n</div>\n\n<script>\n(function() {\n  var HANDLE = '14-trial';\n  var qty = { ac: 0, classic: 0, maple: 0 };\n  var TOTAL = 4;\n  var MAX_FLAVORS = 2;\n  var labels = { ac: 'Apple Cinnamon', classic: 'Classic', maple: 'Maple' };\n  var vid = null;\n  var quoteIndex = 0;\n  var quoteTimer = null;\n  var quotes = [\n    '\"Honestly, this oatmeal surprised me. It tastes good and keeps me full. The original flavor is my go to.\"',\n    '\"Excellent product. The perfect balance of tasty and quick — keeps me running all day!\"',\n    '\"I really like the subtle taste of Maple packed with protein. Satisfying and holds off hunger. Great to find an oatmeal that\\'s good for you!\" — Mary A.',\n    '\"Dawnbreaker is DELICIOUS! Like a pancake in a bowl. The perfect post workout breakfast you can whip up in 2 minutes. BUY IT.\"'\n  ];\n\n  function dbtShowQuote(i) {\n    quoteIndex = i;\n    var el = document.getElementById('dbt-quote-text');\n    if (el) { el.style.opacity = '0'; setTimeout(function(){ el.textContent = quotes[i]; el.style.opacity = '1'; }, 200); }\n    document.querySelectorAll('#dbt .db-quote-dot').forEach(function(d, idx){ d.classList.toggle('active', idx === i); });\n  }\n\n  function dbtNextQuote() { dbtShowQuote((quoteIndex + 1) % quotes.length); }\n  window.dbtGoQuote = function(i) { clearInterval(quoteTimer); dbtShowQuote(i); quoteTimer = setInterval(dbtNextQuote, 4000); };\n  quoteTimer = setInterval(dbtNextQuote, 4000);\n\n  fetch('/products/' + HANDLE + '.js')\n    .then(function(r){ return r.json(); })\n    .then(function(p){ vid = p.variants[0].id; })\n    .catch(function(e){ console.warn('Product fetch failed:', HANDLE); });\n\n  function getTotal() { return qty.ac + qty.classic + qty.maple; }\n  function getFlavorCount() { return Object.keys(qty).filter(function(k){ return qty[k] > 0; }).length; }\n\n  window.dbtUpdateQty = function(f, d) {\n    var nv = qty[f] + d;\n    if (nv < 0) return;\n    if (d > 0) {\n      if (getTotal() >= TOTAL) return;\n      if (qty[f] === 0 && getFlavorCount() >= MAX_FLAVORS) return;\n    }\n    qty[f] = nv;\n    dbtRender();\n  };\n\n  window.dbtToggleFaq = function(btn) {\n    var answer = btn.nextElementSibling;\n    var icon = btn.querySelector('.db-faq-icon');\n    var isOpen = answer.classList.contains('open');\n    document.querySelectorAll('#dbt .db-faq-a').forEach(function(a){ a.classList.remove('open'); });\n    document.querySelectorAll('#dbt .db-faq-icon').forEach(function(i){ i.classList.remove('open'); });\n    if (!isOpen) { answer.classList.add('open'); icon.classList.add('open'); }\n  };\n\n  function dbtRender() {\n    var t = getTotal();\n    var done = t === TOTAL;\n    var flavorCount = getFlavorCount();\n\n    ['ac','classic','maple'].forEach(function(f){\n      var el = document.getElementById('dbt-qty-' + f);\n      if (el) el.textContent = qty[f];\n      var addBtn = document.querySelector('#dbt-card-' + f + ' .db-qty-btn:last-child');\n      if (addBtn) {\n        var wouldExceedTotal = getTotal() >= TOTAL;\n        var wouldAddNewFlavor = qty[f] === 0 && flavorCount >= MAX_FLAVORS;\n        addBtn.disabled = wouldExceedTotal || wouldAddNewFlavor;\n      }\n    });\n\n    var tally = document.getElementById('dbt-tally');\n    if (tally) {\n      if (done) {\n        tally.textContent = '✓ 4 of 4 selected — ready to go!';\n      } else {\n        var rem = TOTAL - t;\n        tally.textContent = t + ' of 4 selected' + (flavorCount >= MAX_FLAVORS && !done ? ' · pick ' + rem + ' more from your 2 flavors' : '');\n      }\n      tally.classList.toggle('complete', done);\n    }\n\n    var mb = document.getElementById('dbt-main-btn');\n    var sb = document.getElementById('dbt-sticky-btn');\n    if (done) {\n      var sum = Object.keys(qty).filter(function(k){ return qty[k] > 0; }).map(function(k){ return labels[k] + ' x' + qty[k]; }).join(', ');\n      if (mb) { mb.disabled = false; mb.textContent = 'Try It for $14 — ' + sum + ' →'; }\n      if (sb) { sb.disabled = false; sb.textContent = 'Try It for $14 →'; }\n    } else {\n      var rem2 = TOTAL - t;\n      if (mb) { mb.disabled = true; mb.textContent = 'Add ' + rem2 + ' more pouch' + (rem2 !== 1 ? 'es' : '') + ' to continue'; }\n      if (sb) { sb.disabled = true; sb.textContent = rem2 + ' more to go'; }\n    }\n  }\n\n  window.dbtAddToCart = function() {\n    if (getTotal() !== TOTAL) return;\n    if (!vid) { alert('Product not found — check the product handle.'); return; }\n    var note = Object.keys(qty).filter(function(k){ return qty[k] > 0; }).map(function(k){ return labels[k] + ': ' + qty[k] + ' pouches'; }).join(' | ');\n    var mb = document.getElementById('dbt-main-btn');\n    var sb = document.getElementById('dbt-sticky-btn');\n    if (mb) { mb.textContent = 'Adding...'; mb.disabled = true; }\n    if (sb) { sb.textContent = 'Adding...'; sb.disabled = true; }\n    fetch('/cart/add.js', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ items: [{ id: vid, quantity: 1, properties: { 'Flavor Selection': note } }] })\n    })\n    .then(function(r){ if (!r.ok) throw new Error('Cart error ' + r.status); window.location.href = '/cart'; })\n    .catch(function(e){\n      console.error('Add to cart failed:', e);\n      if (mb) { mb.textContent = 'Error — try again'; mb.disabled = false; }\n      if (sb) { sb.textContent = 'Error — try again'; sb.disabled = false; }\n    });\n  };\n\n  var sticky = document.getElementById('dbt-sticky');\n  window.addEventListener('scroll', function() {\n    var b = document.querySelector('#dbt .db-builder');\n    if (b && sticky) sticky.classList.toggle('visible', b.getBoundingClientRect().bottom < 0);\n  });\n\n  dbtRender();\n})();\n</script>",
